{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "../target/release/coucou-hook.exe": null,
      "../target/release/coucou-hook": "coucou-hook",
      "../../extensions/copilot/extension.mjs": "copilot/extension.mjs",
      "../../extensions/copilot/package.json": "copilot/package.json",
      "../../extensions/copilot/dist/extension.js": "copilot/dist/extension.js",
      "../../extensions/copilot/dist/bridge.js": "copilot/dist/bridge.js",
      "../../extensions/copilot/dist/runtime.js": "copilot/dist/runtime.js",
      "../../extensions/copilot/dist/public-history.js": "copilot/dist/public-history.js",
      "../../extensions/copilot/dist/protocol.js": "copilot/dist/protocol.js"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libgtk-layer-shell0 (>= 0.6)",
          "libasound2t64 | libasound2",
          "libpipewire-0.3-0"
        ]
      },
      "rpm": {
        "depends": [
          "gtk-layer-shell",
          "alsa-lib",
          "pipewire-libs"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Coucou",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  }
}
